# Cloudflare Pages가 읽는 설정 파일
# events.json과 service-worker.js는 항상 최신 버전을 받도록 캐시를 꺼요
# (자동 업데이트한 행사 정보와 앱 업데이트가 폰에 바로 보이게)

/events.json
  Cache-Control: no-cache

/archive.json
  Cache-Control: no-cache

/service-worker.js
  Cache-Control: no-cache

# 안드로이드 앱(TWA) 확인서: 앱 위쪽 주소창을 없애려면 JSON으로 열려야 해요
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: no-cache
